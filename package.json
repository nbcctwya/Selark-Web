{
  "name": "selark-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup:api": "npm ci --prefix tools/api-types --ignore-scripts",
    "generate:api": "node tools/api-types/generate.mjs",
    "check:api": "node tools/api-types/generate.mjs --check",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "npm run build && playwright test",
    "build": "tsc --noEmit && vite build && node scripts/check-build.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "ajv": "8.20.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
