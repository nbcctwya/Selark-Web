{
  "name": "selark-desktop",
  "version": "0.5.6",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "description": "Selark Windows desktop workspace",
  "author": "Selark",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "install-electron",
    "setup:api": "npm ci --prefix tools/api-types --ignore-scripts",
    "generate:api": "node tools/api-types/generate.mjs",
    "check:api": "node tools/api-types/generate.mjs --check",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:native": "node --test electron/*.test.cjs",
    "desktop": "npm run build:backend && npm run build && electron .",
    "desktop:run": "electron .",
    "build:backend": "node scripts/build-backend.mjs",
    "package:win": "npm run build:backend && npm run build && electron-builder --win --x64 --publish never",
    "package:dir": "npm run build:backend && npm run build && electron-builder --win --x64 --dir",
    "test:windows": "node scripts/test-native.mjs",
    "test:windows:desktop": "node scripts/test-native-desktop.mjs",
    "test:desktop": "node scripts/test-desktop.mjs",
    "test:wsl": "node scripts/test-wsl.mjs",
    "test:wsl:desktop": "node scripts/test-wsl-desktop.mjs",
    "test:package": "node scripts/test-package.mjs",
    "bench:desktop": "node scripts/bench-desktop.mjs",
    "test:browser": "npm run build && node scripts/test-browser.mjs",
    "build": "tsc --noEmit && vite build && node scripts/check-build.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "ajv": "8.20.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
